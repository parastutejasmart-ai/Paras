# Server-only AI access
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Server-only Gmail SMTP access. Use a Google App Password, not your Gmail password.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
REPLY_TO_EMAIL=

# Server-only Supabase access used for sent-email history.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long, unique password required before the dashboard can generate or send.
DASHBOARD_PASSWORD=